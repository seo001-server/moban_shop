# Storefront `users` and back-office table `admin` are separate accounts.
# Seed admin: sql/seed/admin_demo.sql · new bcrypt hash: go run ./cmd/staff-hash "YourPassword"#
# DATABASE_DSN must use parseTime=true (and loc=UTC recommended).
DATABASE_DSN=user:pass@tcp(127.0.0.1:3306)/moban_shop?parseTime=true&loc=UTC&charset=utf8mb4

HTTP_ADDR=:8080


# Development: "*" allows any Origin. Production: comma-separated origins, no spaces requirement (trim applied).
ALLOW_ORIGINS=*

# Required: HS256 signing key. Prefer 32+ random characters in production.
JWT_SECRET=change-me-to-at-least-16-chars-long
JWT_ISSUER=moban_shop

# Access token TTL in seconds (default 86400 = 24h; server caps at 30d).
JWT_ACCESS_TTL_SECONDS=86400

# Admin API JWT (must differ from JWT_SECRET). Used only for /api/admin/** after POST /api/admin/auth/login.
JWT_ADMIN_SECRET=change-admin-secret-to-at-least-16-different-from-user-secret
JWT_ADMIN_ISSUER=moban_shop_admin

# Defaults to JWT_ACCESS_TTL_SECONDS if unset.
JWT_ADMIN_ACCESS_TTL_SECONDS=86400